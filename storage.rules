rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function owner() {
      return signedIn() && request.auth.token.email == 'clayvertonoliveira@gmail.com';
    }
    function hasLegacy() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid));
    }
    function hasInvite() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/convites/$(request.auth.token.email));
    }
    function active() {
      return hasLegacy()
        ? firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.ativo == true
        : (hasInvite() && firestore.get(/databases/(default)/documents/convites/$(request.auth.token.email)).data.ativo == true);
    }
    function member() {
      return signedIn() && (owner() || active());
    }
    function role() {
      return hasLegacy()
        ? firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.perfil
        : firestore.get(/databases/(default)/documents/convites/$(request.auth.token.email)).data.perfil;
    }
    function manager() {
      return member() && (owner() || role() in ['admin','supervisor','sst']);
    }
    function acceptedContent() {
      return request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/png',
          'image/webp',
          'text/csv',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.oasis.opendocument.text',
          'application/vnd.oasis.opendocument.spreadsheet'
        ];
    }
    match /sst/{group}/{documentId}/{fileName} {
      allow read: if group in ['evidencias', 'programasSst'] && member();
      allow create: if group in ['evidencias', 'programasSst'] && manager() && acceptedContent();
      allow update: if false;
      allow delete: if group in ['evidencias', 'programasSst'] && manager();
    }
  }
}
